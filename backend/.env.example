# =============================================
# CONFIGURAÇÃO DO BANCO DE DADOS (PostgreSQL)
# =============================================
# Preencha com os dados do SEU banco PostgreSQL.
# Depois rode: npm run migrate && npm run seed
# =============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lume

# =============================================
# SERVIDOR
# =============================================
PORT=4000
# Origem permitida no CORS (separar várias com vírgula)
CLIENTE_ORIGEM=http://localhost:5173
# URL pública deste backend (usada no webhook do Mercado Pago)
# Exemplo: https://seu-dominio.com ou http://localhost:4000 (via túnel)
BACKEND_URL=http://localhost:4000

# =============================================
# MERCADO PAGO (pagamento real)
# =============================================
# Deixe vazio para manter o pagamento simulado (sem cobrança).
# Para ativar: crie a aplicação em https://www.mercadopago.com.br/developers
# e cole aqui o Access Token de produção ou de teste.
MP_ACCESS_TOKEN=

# Segredo da assinatura dos webhooks (painel do MP > Suas integrações >
# Webhooks > Configurar notificação > revelar chave).
# Sem esse segredo, a validação de assinatura é ignorada com aviso no log.
MP_WEBHOOK_SECRET=

# =============================================
# PRODUÇÃO
# =============================================
# Ative quando houver proxy reverso na frente (nginx/Railway/Render) para o
# rate limit enxergar o IP real do cliente. Em produção: TRUST_PROXY=true
TRUST_PROXY=false

# =============================================
# ADMIN INICIAL (npm run seed:admin)
# =============================================
# Email do admin criado pelo seed (opcional; padrão: admin@lume.com)
ADMIN_EMAIL=
# Senha do admin. Se vazio, o seed gera uma senha forte e imprime uma vez.
ADMIN_SENHA=
ADMIN_NOME=

# =============================================
# SEGURANÇA
# =============================================
# Segredo usado para assinar os tokens JWT (troque por um valor aleatório)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# =============================================
# LOGS
# =============================================
# Nível de log: debug, info, warn, error
LOG_LEVEL=info
