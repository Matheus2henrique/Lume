# =============================================
# CONFIGURAÇÃO DO BANCO DE DADOS (PostgreSQL)
# =============================================
# Preencha com os dados do SEU banco PostgreSQL.
# Depois rode: npm run migrate && npm run seed
# =============================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# =============================================
# SERVIDOR
# =============================================
# Ambiente: development | test | production
# Em production o servidor valida os segredos (JWT, CORS, senha do banco)
# e RECUSA iniciar se algum estiver fraco.
# NODE_ENV=production
PORT=4000
# Origem permitida no CORS (separar várias com vírgula)
CLIENTE_ORIGEM=http://localhost:5173
# URL pública deste backend (usada no webhook do Mercado Pago)
# Exemplo: https://seu-dominio.com ou http://localhost:4000 (via túnel)
BACKEND_URL=http://localhost:4000

# =============================================
# MERCADO PAGO (pagamento real)
# =============================================
# Deixe vazio para manter o pagamento simulado (sem cobrança).
# Para ativar: crie a aplicação em https://www.mercadopago.com.br/developers
# e cole aqui o Access Token de produção ou de teste.
MP_ACCESS_TOKEN=

# Segredo da assinatura dos webhooks (painel do MP > Suas integrações >
# Webhooks > Configurar notificação > revelar chave).
# Em PRODUÇÃO com MP_ACCESS_TOKEN preenchido este segredo é OBRIGATÓRIO:
# o servidor recusa iniciar sem ele e todo webhook sem assinatura válida
# recebe 401. Em desenvolvimento a validação é pulada com aviso no log.
MP_WEBHOOK_SECRET=

# =============================================
# MELHOR ENVIO (cálculo de frete)
# =============================================
# Deixe ME_TOKEN vazio para manter o site SEM frete (comportamento atual).
# Para ativar: crie conta em https://www.melhorenvio.com.br, gere o token
# em Painel > API e cole aqui. Documentação: https://docs.melhorenvio.com.br
ME_TOKEN=
# Ambiente: sandbox (testes, sem gastar saldo) | production (real)
ME_AMBIENTE=sandbox
# CEP da loja/remetente — apenas dígitos, sem hífen (ex.: 45001000)
ME_CEP_ORIGEM=
# Transportadoras a cotar, separadas por vírgula (ex.: 1,2,18).
# Vazio = todas as disponíveis para o trecho.
ME_SERVICOS=
# Contato exibido no header User-Agent (exigência da API): "App (email)"
ME_CONTATO=

# =============================================
# PRODUÇÃO
# =============================================
# Ative quando houver proxy reverso na frente (nginx/Railway/Render) para o
# rate limit enxergar o IP real do cliente. Em produção: TRUST_PROXY=true
TRUST_PROXY=false

# =============================================
# ADMIN INICIAL (npm run seed:admin)
# =============================================
# Email do admin criado pelo seed (opcional; padrão: admin@lume.com)
ADMIN_EMAIL=
# Senha do admin. Se vazio, o seed gera uma senha forte e imprime uma vez.
ADMIN_SENHA=
ADMIN_NOME=

# =============================================
# SEGURANÇA
# =============================================
# Segredo usado para assinar os tokens JWT.
# Em PRODUCAÇÃO o servidor recusa iniciar se estiver ausente, fraco (< 32
# caracteres) ou for o placeholder. Gere um forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# =============================================
# E-MAIL (verificação de conta no cadastro)
# =============================================
# Funciona com qualquer caixa de destino (Gmail, Outlook, Yahoo...).
# Para Gmail: ative 2FA e crie uma SENHA DE APP em
# https://myaccount.google.com/apppasswords (não use a senha normal).
# Deixe EMAIL_SMTP_PASS vazio para desenvolvimento: o código é só
# impresso no console do backend em vez de enviado.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_REMETENTE=Lume <nao-responda@lume.com>
# Opcional: PEM de CA extra quando um antivírus/proxy intercepta TLS localmente
# (ex.: Avast Web/Mail Shield). Caminho relativo a backend/ ou absoluto.
# Em produção (sem interceptação) deixe vazio.
EMAIL_SMTP_EXTRA_CA=

# ==========================================
# LOGIN COM GOOGLE (opcional)
# ==========================================
# Client ID (tipo Web) do Google Cloud Console > APIs e serviços > Credenciais.
# Origem autorizada: a URL do front (ex.: http://localhost:5173).
# Vazio = POST /auth/google responde 503 e o botão Google mostra aviso.
# O front usa o MESMO valor em VITE_GOOGLE_CLIENT_ID (frontend/.env).
GOOGLE_CLIENT_ID=

# =============================================
# LOGS
# =============================================
# Nível de log: debug, info, warn, error
LOG_LEVEL=info

# =============================================
# BANCO GERENCIADO (Neon / Supabase / Render / RDS)
# =============================================
# Ative para exigir TLS na conexão com o Postgres. O provedor gerenciado
# entrega um certificado confiável pelo sistema operacional — em alguns
# ambientes (proxy corporativo/antivírus) pode ser preciso liberar a
# verificação com DB_SSL_REJECT_UNAUTHORIZED=false (use só se souber o motivo).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Pool e timeouts (evita conexão pendurada segurando worker e banco)
DB_POOL_MAX=10
DB_CONN_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
# Cancela consulta que roda além do limite (evita query travada segurando lock)
DB_STATEMENT_TIMEOUT_MS=30000